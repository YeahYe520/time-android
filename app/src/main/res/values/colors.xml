<?xml version="1.0" encoding="utf-8"?>
<!--
  注意：XML 的注释里不能出现连续两个半角减号。
  这是 XML 规范的硬规定——注释的结束标记本身就是「两个减号加一个大于号」，
  解析器一看到两个减号就分不清你是想结束注释还是只是打字，干脆一律报错。
  HTML 也有同样的规定，但浏览器睁一只眼闭一只眼；XML 解析器不惯着，直接构建失败。

  踩过的坑：一开始这里提到了网页那边的 CSS 变量名，那个名字前面带两个减号，
  aapt2 直接报「注释中不能包含连续的字符串」。

  而且注意：上面这段说明本身也不能把那两个减号写出来，
  只能绕着说「两个减号」——这就是为什么这段话读起来有点别扭。
-->
<resources>
    <!-- 图标底色。跟网页 CSS 变量 accent 是同一个绿，看起来像一套东西。 -->
    <color name="icon_bg">#2F6F4E</color>

    <!-- 设置面板的底色。跟网页背景色 bg 一致。 -->
    <color name="settings_bg">#F7F6F3</color>

    <color name="hint">#6F6B64</color>
</resources>
